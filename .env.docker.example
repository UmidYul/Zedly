# Local-only Docker environment (copy to .env.docker.local)
COMPOSE_PROJECT_NAME=zedly_local

ZEDLY_APP_PORT=5000
ZEDLY_DB_PORT=5433
ZEDLY_DB_NAME=zedly_local
ZEDLY_DB_USER=zedly_local_user
ZEDLY_DB_PASSWORD=zedly_local_password
ZEDLY_DUMP_OWNER_ROLE=zedlyuz

JWT_SECRET=change_this_local_jwt_secret
JWT_REFRESH_SECRET=change_this_local_refresh_secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

ZEDLY_API_URL=http://localhost:5000
ZEDLY_FRONTEND_URL=http://localhost:5000
ZEDLY_APP_URL=http://localhost:5000
ZEDLY_WEB_BASE_URL=http://localhost:5000
ZEDLY_API_BASE_URL=http://localhost:5000
ZEDLY_CORS_ALLOWED_ORIGINS=http://localhost:5000
