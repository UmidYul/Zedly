# Local-only Docker environment (copy to .env.docker.local)
COMPOSE_PROJECT_NAME=zedly_local

# Optional image overrides (useful if Docker Hub is blocked/slow)
NODE_IMAGE=public.ecr.aws/docker/library/node:20-alpine
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine

ZEDLY_APP_PORT=3001
ZEDLY_DB_PORT=5433
ZEDLY_DB_NAME=zedly_local
ZEDLY_DB_USER=zedly_local_user
ZEDLY_DB_PASSWORD=zedly_local_password
ZEDLY_DUMP_OWNER_ROLE=zedlyuz

JWT_SECRET=change_this_local_jwt_secret
JWT_REFRESH_SECRET=change_this_local_refresh_secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

ZEDLY_API_URL=http://localhost:3001
ZEDLY_FRONTEND_URL=http://localhost:3001
ZEDLY_APP_URL=http://localhost:3001
ZEDLY_WEB_BASE_URL=http://localhost:3001
ZEDLY_API_BASE_URL=http://localhost:3001
ZEDLY_CORS_ALLOWED_ORIGINS=http://localhost:3001

# Email / SMTP (required for profile email verification code)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_PASS=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_PASS=your_app_password
EMAIL_FROM=ZEDLY <your_email@gmail.com>
EMAIL_TEMPLATE_THEME=corporate
