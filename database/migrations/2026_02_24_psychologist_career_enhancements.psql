-- Psychologist role + career module enhancements
-- Safe to run multiple times.

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_type t
        JOIN pg_enum e ON e.enumtypid = t.oid
        WHERE t.typname = 'user_role'
          AND e.enumlabel = 'psychologist'
    ) THEN
        ALTER TYPE public.user_role ADD VALUE 'psychologist';
    END IF;
END $$;

ALTER TABLE public.career_interests
    ADD COLUMN IF NOT EXISTS school_id uuid,
    ADD COLUMN IF NOT EXISTS subject_keywords jsonb DEFAULT '[]'::jsonb;

CREATE INDEX IF NOT EXISTS idx_career_interests_school_id
    ON public.career_interests (school_id);

ALTER TABLE public.student_career_results
    ADD COLUMN IF NOT EXISTS interests_scores jsonb,
    ADD COLUMN IF NOT EXISTS recommended_subjects jsonb,
    ADD COLUMN IF NOT EXISTS reliability jsonb,
    ADD COLUMN IF NOT EXISTS completed_at timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    ADD COLUMN IF NOT EXISTS attempt_no integer;

UPDATE public.student_career_results scr
SET completed_at = COALESCE(scr.completed_at, scr.taken_at, CURRENT_TIMESTAMP)
WHERE scr.completed_at IS NULL;

WITH numbered AS (
    SELECT
        id,
        ROW_NUMBER() OVER (
            PARTITION BY student_id
            ORDER BY COALESCE(completed_at, taken_at, CURRENT_TIMESTAMP), id
        ) AS rn
    FROM public.student_career_results
)
UPDATE public.student_career_results scr
SET attempt_no = numbered.rn
FROM numbered
WHERE scr.id = numbered.id
  AND (scr.attempt_no IS NULL OR scr.attempt_no <= 0);

CREATE INDEX IF NOT EXISTS idx_student_career_results_student_completed
    ON public.student_career_results (student_id, completed_at DESC);

CREATE INDEX IF NOT EXISTS idx_student_career_results_student_attempt
    ON public.student_career_results (student_id, attempt_no DESC);

INSERT INTO public.notification_role_defaults (role, frequency)
VALUES ('psychologist', 'instant')
ON CONFLICT (role) DO NOTHING;

