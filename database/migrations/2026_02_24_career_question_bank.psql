BEGIN;

CREATE TABLE IF NOT EXISTS public.career_question_bank (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    school_id uuid NOT NULL REFERENCES public.schools(id) ON DELETE CASCADE,
    interest_id uuid NOT NULL REFERENCES public.career_interests(id) ON DELETE CASCADE,
    text_ru text NOT NULL DEFAULT '',
    text_uz text NOT NULL DEFAULT '',
    order_no integer NOT NULL DEFAULT 0,
    is_active boolean NOT NULL DEFAULT true,
    created_by uuid NULL REFERENCES public.users(id) ON DELETE SET NULL,
    created_at timestamp without time zone NOT NULL DEFAULT now(),
    updated_at timestamp without time zone NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_career_question_bank_school
    ON public.career_question_bank (school_id);

CREATE INDEX IF NOT EXISTS idx_career_question_bank_interest
    ON public.career_question_bank (interest_id);

CREATE INDEX IF NOT EXISTS idx_career_question_bank_school_active_order
    ON public.career_question_bank (school_id, is_active, order_no);

COMMIT;
