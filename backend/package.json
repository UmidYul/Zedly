{
  "name": "zedly-backend",
  "version": "1.0.0",
  "description": "ZEDLY Educational Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:api": "node src/api-server.js",
    "start:web": "node src/web-server.js",
    "start:worker": "node src/worker.js",
    "dev": "nodemon src/server.js",
    "dev:api": "nodemon src/api-server.js",
    "dev:web": "nodemon src/web-server.js",
    "build:frontend": "node scripts/build-frontend.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:school-geo": "node scripts/migrate-school-geo-profile.js",
    "db:seed": "node scripts/seed.js",
    "db:backup": "node scripts/backup.js",
    "test": "npm run test:unit",
    "test:unit": "jest src/routes/superadmin.geo.test.js --runInBand",
    "test:smoke": "jest src/tests/smoke.e2e.test.js --runInBand --forceExit",
    "lint": "eslint \"src/**/*.js\" \"scripts/**/*.js\" \"app.js\" \"generate_hash.js\" --no-error-on-unmatched-pattern",
    "cron:notifications": "node -e \"require('./src/jobs/notificationDigest').runNotificationDigestOnce().then((s)=>{console.log(s);process.exit(0)}).catch((e)=>{console.error(e);process.exit(1)})\""
  },
  "keywords": [
    "education",
    "testing",
    "school",
    "uzbekistan"
  ],
  "author": "ZEDLY Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "npm:bcryptjs@^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "7.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "qs": "^6.15.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "javascript-obfuscator": "^4.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "terser": "^5.46.0"
  },
  "overrides": {
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "readdir-glob": "^2.0.2",
    "unzipper": "^0.12.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
