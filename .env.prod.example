# Used for both docker-compose.prod and non-Docker Node.js hosting.
COMPOSE_PROJECT_NAME=zedly_prod

PUBLIC_HTTP_PORT=80

DB_NAME=zedly
DB_USER=zedly_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

JWT_SECRET=change_me_jwt
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

APP_URL=https://app.zedly.uz
WEB_BASE_URL=https://app.zedly.uz
API_BASE_URL=https://api.zedly.uz
CORS_ALLOWED_ORIGINS=https://app.zedly.uz
COOKIE_SAME_SITE=None
COOKIE_DOMAIN=.zedly.uz

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=240

ENABLE_DEADLINE_REMINDER_JOB=true
ENABLE_NOTIFICATION_DIGEST_JOB=true
SERVE_COMPILED_FRONTEND=true
