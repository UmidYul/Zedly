# Base URL of target environment
BASE_URL=https://your-prod-domain.com

# Optional bearer token for protected endpoints
AUTH_TOKEN=

# Think time between iterations (seconds)
THINK_TIME=0.2

# Smoke scenario
SMOKE_RPS=20
SMOKE_DURATION=1m
SMOKE_VUS=20
SMOKE_MAX_VUS=100

# Load scenario
LOAD_START_RPS=30
LOAD_VUS=50
LOAD_MAX_VUS=300
LOAD_STAGE1_RPS=80
LOAD_STAGE1_DURATION=2m
LOAD_STAGE2_RPS=120
LOAD_STAGE2_DURATION=2m
LOAD_STAGE3_RPS=160
LOAD_STAGE3_DURATION=2m
LOAD_COOLDOWN=30s
LOAD_START_TIME=1m10s
